{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poyo-billiards-ranking",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // 断片の組み立てと記録の保管（プロトコル v2、2026-10-12）。無料プランは SQLite の Durable Object
  "durable_objects": { "bindings": [{ "name": "ASM", "class_name": "Assembler" }] },
  "migrations": [{ "tag": "v2", "new_sqlite_classes": ["Assembler"] }],
  // 集計の起動（2026-10-14）：毎時 0・15・30・45 分に GitHub Actions の export-ranking を workflow_dispatch で起動する。
  //   v1 の "*/30" が Cloudflare に残り、"*/15" に替えても 1 時間近く "*/30" のまま動いたので、別の書き方で入れ直した
  "triggers": { "crons": ["*/15 * * * *"] }
  // 秘密（wrangler secret put）：SALT（送り元の IP のハッシュの塩）、EXPORT_KEY（/delta.txt の鍵。GitHub の Secrets の RANKING_KEY と同じ）、
  //   GH_DISPATCH_TOKEN（集計の起動用。UndefinedRepoName の Actions: Read and write だけの Fine-grained トークン）
  // 旧 D1（poyo-billiards-ranking）は v1 の時のもの。今は使っていない
}
